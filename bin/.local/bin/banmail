#!/usr/bin/env bash

DISPLAY=:0

# Check if Thunderbird passed a file path argument
if [ -n "$1" ] && [ -f "$1" ]; then
    mail=$(grep -i "^From:" "$1" | grep -o "[^<> ]\+@.\+\\.[^<>]\+" | head -n 1)
else
    mail=$(grep -i "^From:" /dev/stdin | grep -o "[^<> ]\+@.\+\\.[^<>]\+" | head -n 1)
fi

if [ -z "$mail" ]; then
    echo "No valid email address found."
    exit 1
fi

domainOrNot=$(echo "Block the domain
Block the user on the domain" | fuzzel --dmenu -p "Action for $mail:")

if [[ "$domainOrNot" = "Block the domain" ]]; then
    domain=$(echo "$mail" | cut -d'@' -f2)
    choice=$(echo "y
n" | fuzzel --dmenu -p "Block the domain $domain?")
    if [[ "$choice" = "y" ]]; then
        ssh root@skykosiner.com "./banmail $domain"
    fi
elif [[ "$domainOrNot" = "Block the user on the domain" ]]; then
    choice=$(echo "y
n" | fuzzel --dmenu -p "Block the email $mail?")
    if [[ "$choice" = "y" ]]; then
        ssh root@skykosiner.com "./banmail $mail"
    fi
fi

